# Visualisateur Psychédélique - .gitignore
# https://github.com/github/gitignore/blob/main/Python.gitignore

# ============================================================================
# OS / Editor
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DS_Store?
*.pem

# Linux
*~

# Windows
Thumbs.db
Thumbs.db:enc
ehthumbs.db
ehthumbs_vista.db
*.tmp
*.temp

# IDE / Editor
# ============================================================================

# VS Code
.vscode/
*.code-workspace
*.code-workspace.json

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~

# ============================================================================
# Python
# ============================================================================

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ============================================================================
# Conteneurs (Podman / Docker)
# ============================================================================

# Fichiers temporaires Podman
.podman/
.podman-*
containers/
podman/

# Images et conteneurs Docker
.docker/

# Dossiers montés comme volumes (pour éviter de commiter des données locales)
# Note: /audio/ était dans cette liste mais c'est un module source qui doit être versionné
/output/
/data/

# Dossier de sortie local (dans le projet)
output/

# Dossier d'entrée pour les fichiers audio/vidéo à analyser
input/

# ============================================================================
# Vidéo / Audio (TOUS les fichiers mp4/mp3/wav/etc. sont ignorés)
# ============================================================================

# TOUS les fichiers vidéo
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.gif

# TOUS les fichiers audio (y compris mp3, wav, etc.)
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.m4a

# Fichiers temporaires FFmpeg
*.mpg
*.mpeg
*.ts
*.m2ts

# ============================================================================
# Fichiers de configuration locale
# ============================================================================

# Fichiers de configuration qui ne doivent pas être partagés
.env
.env.local
.env.*.local
config.local.json
config.local.yml
secrets.yml

# ============================================================================
# Logs et cache
# ============================================================================

# Logs
*.log
logs/

# Cache
.cache/
*.cache

# ============================================================================
# Système
# ============================================================================

# Fichiers temporaires
*.tmp
*.temp
*~

# Fichiers de verrouillage
*.lock

# ============================================================================
# Exceptions (à garder dans le dépôt)
# ============================================================================

# Fichiers de configuration par défaut (sans données sensibles)
!.env.example
!.env.default
!config.default.json
!config.default.yml

# Documentation
!*.md
!.gitignore

# Scripts exécutables
!*.sh
!Makefile
!Dockerfile

# Code source Python
!*.py
!requirements.txt
!setup.py

# Tests
!tests/

# ============================================================================
# Fin
# ============================================================================

# =============================================================================
# Builds Standalone
# =============================================================================

dist_standalone/
Visualisateur.AppDir/
build_standalone/
build_venv/
linuxdeploy*.AppImage
*.AppImage

